# Copy to .env. Never commit credentials.
# Base URL includes the API version prefix; /chat/completions is appended.
LLM_API_BASE=https://your-provider.example/v1
LLM_API_KEY=
PROPOSER_MODEL=your-proposer-model
JUDGE_MODEL=your-judge-model
CRITIC_MODEL=your-critic-model
# Optional per-role endpoint/key overrides:
# PROPOSER_API_BASE=
# PROPOSER_API_KEY=
# JUDGE_API_BASE=
# JUDGE_API_KEY=
# CRITIC_API_BASE=
# CRITIC_API_KEY=
